.env
__pycache__/
*.py[cod]
.venv/
venv/

# Uploaded proof documents must never be committed
storage/proofs/*
!storage/proofs/.gitkeep

*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# SSH keys and certificates must never be committed
*.key
*.pem
*.ppk
*.p12
*.pfx
*.pub
id_rsa*
id_ed25519*
# Local SQL store. The database is built by migrations/import_college_data.py
# and must never be committed -- it holds staff and student records.
local-dev.db
local-dev.db-wal
local-dev.db-shm
*.sqlite
*.sqlite3
