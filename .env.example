# ------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
#   Windows:  copy .env.example .env
#   mac/Linux: cp .env.example .env
# .env is gitignored and must never be committed.
#
# On Render, set these as Environment Variables in the dashboard instead.
# ------------------------------------------------------------------

# Random string used to sign session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs every signed-in user out.
SECRET_KEY=your-secret-key-here

# ------------------------------------------------------------------
# Supabase Postgres
# ------------------------------------------------------------------
# Project Settings -> Database -> Connection string -> URI (Direct).
#
# Use the DIRECT connection, db.<ref>.supabase.co. The app dials this URI exactly
# as written: there is no pooler host, no startup probe and no fallback. Supavisor
# is not used at all -- it reaps and reschedules session connections underneath
# the client, which is where "consuming input failed: SSL SYSCALL error: EOF
# detected" comes from, and it shares one slot limit between everything pointed
# at the project. This app pools for itself, so there is nothing for Supavisor to
# pool.
#
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
# db.<ref>.supabase.co is published as an IPv6-only AAAA record, so the host you
# run from needs IPv6 egress or the name will not resolve at all. The pool still
# opens in the background in that case, so the app boots and recovers on its own.
#
# Passwords with @ / : # must be percent-encoded in the URI.
DATABASE_URL=postgresql://postgres:your-password@db.cndqajpjmnvsafrxjowx.supabase.co:5432/postgres

# Only used to build DATABASE_URL when the variable above is absent: the ref is
# read from the URI above, so setting both is redundant.
SUPABASE_PROJECT_REF=cndqajpjmnvsafrxjowx

# Per-process pool. Total connections = this x number of gunicorn workers, and
# the direct endpoint charges it straight to the Supabase project's connection
# limit. DB_POOL_MAX must EXCEED the --threads one worker serves, or a worker
# deadlocks against itself: every thread holds a connection while a query runs.
# DB_POOL_MIN is what keeps that from cascading. The pool grows one connection
# at a time, and only once a client is already queued, and a connect to
# Supabase costs over a second -- so a pool sitting at MIN=1 that loses that
# one connection has nothing to serve while it redials, and every request
# behind it times out. Set MIN = --threads so each thread finds a warm
# connection instead of waiting on a dial. A MIN below --threads is raised to
# --threads at startup, with a log line saying so.
#
# 2 workers x 4 threads: 4 warm, 6 available per process, 12 at the top end.
DB_POOL_MIN=4
DB_POOL_MAX=6

# Must match the gunicorn flags. The pool reads these to size itself and to
# state the connection budget in the startup log.
DB_WORKER_THREADS=4
DB_WORKER_COUNT=2

# Timeouts, kept separate on purpose.
#   DB_CONNECT_TIMEOUT - one TCP connect + auth handshake
#   DB_POOL_TIMEOUT    - how long a request waits for a free connection
#   DB_POOL_RETRIES    - how many times to try before reporting failure
# A connect must not be able to consume the whole pool wait, or one unreachable
# database turns every request into a full-timeout stall.
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=5
DB_POOL_RETRIES=2

# Pool housekeeping. Retiring idle connections after 4 minutes means the pool
# never hands out a socket the server has already closed.
DB_POOL_MAX_IDLE=240
DB_POOL_MAX_LIFETIME=1800
DB_POOL_RECONNECT_TIMEOUT=30

# How long a pooled connection may be handed out without being re-verified with
# a SELECT 1. A socket the network dropped while idle still looks alive to
# libpq, so without this the first query after a quiet spell is the one that
# discovers it is dead. 30s costs one round trip per idle gap and none on a hot
# path. 0 trusts libpq's own view, which cannot see a severed flow.
DB_POOL_PING_INTERVAL=30

# ------------------------------------------------------------------
# Supabase Storage, for uploaded proof documents
# ------------------------------------------------------------------
# Create a PRIVATE bucket (Storage -> New bucket -> Public off). Proofs carry
# medical and identity documents, so they are only ever served back through an
# authorised route in app/faculty/routes.py.
#
# SUPABASE_SECRET_KEY -> Project Settings -> API Keys. This key bypasses Row
# Level Security, so it is a server-side secret: never put it in a template, a
# JavaScript file, or any client-side code. Rotate it if it is ever committed,
# pasted into a chat, or logged.
#
# Projects created before the rename publish this as SUPABASE_SERVICE_ROLE_KEY
# (a long service_role JWT); the app accepts either.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_STORAGE_BUCKET=proofs
STORAGE_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------
# Microsoft Entra ID  (Aditya University Permission Portal)
# Single-tenant app: "Accounts in this organizational directory only"
#
# CLIENT_ID / TENANT_ID  -> App registrations -> your app -> Overview
# CLIENT_SECRET           -> Certificates & secrets -> New client secret
#                           (copy the secret VALUE, not its ID)
#
# REDIRECT_URI must match a registered Web redirect URI EXACTLY,
# including scheme, host, port and path. On Render that is the
# service URL, which is stable across deploys:
#   https://<your-service>.onrender.com/auth/callback
# ------------------------------------------------------------------
CLIENT_ID=your-client-id
TENANT_ID=your-tenant-id
CLIENT_SECRET=your-client-secret

REDIRECT_URI=https://permission-system.onrender.com/auth/callback

# ------------------------------------------------------------------
# Web server
# ------------------------------------------------------------------
# Local only by default. Render injects PORT and sets HOST itself.
HOST=127.0.0.1
PORT=5000

# Development only. Set to false for any real deployment.
FLASK_DEBUG=true

# Development only. Re-reads templates on every request, so a saved template is
# picked up without restarting the server. Without it Jinja keeps the compiled
# template for the life of the process while CSS is read fresh from disk, and
# the two drift apart into a broken-looking layout. Set to false in production.
TEMPLATES_AUTO_RELOAD=true

# Render terminates TLS, so the app is always reached over HTTPS. Set true.
SESSION_COOKIE_SECURE=false

# Sign a session out after this many seconds without activity.
IDLE_TIMEOUT_SECONDS=3600

# Timezone used to bucket requests into chart/report days. Timestamps are
# stored as timestamptz (UTC); this decides which calendar day a late-evening
# submission belongs to.
REPORT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------
# Outlook SMTP  (university tenant: smtp.office365.com)
# Leave blank to disable email: requests still submit, the app just
# logs that it could not notify.
#
# NOTE: Render's Free compute plan blocks all outbound traffic on ports
# 25, 465 and 587, so SMTP only works on a paid plan. Until then, leave
# these blank and the app will log that notifications were suppressed.
# ------------------------------------------------------------------
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your-outlook-email@adityauniversity.in
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-outlook-email@adityauniversity.in

# ------------------------------------------------------------------
# Local development sign-in
# Set to false once Entra ID sign-in works. The /auth/dev-login route
# then returns 404 and cannot be used to bypass Microsoft.
# ------------------------------------------------------------------
DEV_MODE=true
DEV_ALLOWED_DOMAIN=adityauniversity.in
