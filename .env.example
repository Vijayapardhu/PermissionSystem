# ------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
#   Windows:  copy .env.example .env
#   mac/Linux: cp .env.example .env
# .env is gitignored and must never be committed.
#
# On Render, set these as Environment Variables in the dashboard instead.
# ------------------------------------------------------------------

# Random string used to sign session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs every signed-in user out.
SECRET_KEY=your-secret-key-here

# ------------------------------------------------------------------
# Cloud Firestore  (all application data)
# ------------------------------------------------------------------
# FIREBASE_PROJECT_ID   -> Firebase -> Project settings -> General
# FIRESTORE_DATABASE    -> (default) unless you created a named database
#
# Credentials are the service account's private key, read from exactly one of:
#   FIREBASE_CREDENTIALS_PATH  a file on disk (local runs)
#   FIREBASE_CREDENTIALS_JSON  the same JSON inline (Render, CI)
#
# !! ROTATE !! anything pasted into a chat transcript is compromised.
# Firebase -> Project settings -> Service accounts -> Generate new private key.
# The key bypasses Firestore security rules entirely, so it is a server-side
# secret: never in a template, a JavaScript file, or any client-side code.
FIREBASE_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)
FIREBASE_CREDENTIALS_PATH=C:\path\to\your-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# How long one store call may take before the request gives up. Short, because a
# hung call holds a gunicorn worker thread and the page waits on the thread.
FIRESTORE_TIMEOUT_SECONDS=8

# Attempts per request. Two means one dropped call is survivable and a real
# outage still fails well inside the gunicorn request timeout.
FIRESTORE_RETRIES=2

# Calendar days on the charts and reports. Timestamps are stored in UTC; a
# request filed at 23:30 IST lands on that IST day, not on the next UTC one.
REPORT_TIMEZONE=Asia/Kolkata

# How long /healthz may reuse its previous verdict. Render polls it
# continuously, and an uncached probe costs a query on every poll.
HEALTH_DB_CACHE_SECONDS=30

# Develop offline against the Firestore emulator, which ignores credentials.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ------------------------------------------------------------------
# Cloudflare R2, for uploaded proof documents
# ------------------------------------------------------------------
# Create the bucket (R2 -> Create bucket) and leave public access OFF. Proofs
# carry medical and identity documents, so they are only ever served back
# through an authorised route in app/faculty/routes.py.
#
# R2_ACCOUNT_ID     -> R2 overview, right-hand side
# R2_ACCESS_KEY_ID  -> R2 -> Manage R2 API Tokens -> Create Account API token
# R2_SECRET_ACCESS_KEY -> (both values are shown once, at creation)
#
# The token bypasses every bucket policy, so it is a server-side secret: never
# put it in a template, a JavaScript file, or any client-side code. Rotate it if
# it is ever committed, pasted into a chat, or logged.
#
# STORAGE_BACKEND is r2 (the default) or supabase. Set it to supabase to keep
# using the Supabase Storage values below instead.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=permission-system

# Seconds for one storage round trip, connect plus read or write. Long enough for
# a 5 MB proof over a slow link, short enough that a hung request cannot hold a
# worker thread for the gunicorn timeout.
STORAGE_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------
# Supabase Storage, only read when STORAGE_BACKEND=supabase
# ------------------------------------------------------------------
# SUPABASE_SECRET_KEY -> Project Settings -> API Keys. This key bypasses Row
# Level Security, so it is a server-side secret: never put it in a template, a
# JavaScript file, or any client-side code. Rotate it if it is ever committed,
# pasted into a chat, or logged.
#
# Projects created before the rename publish this as SUPABASE_SERVICE_ROLE_KEY
# (a long service_role JWT); the app accepts either.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_STORAGE_BUCKET=permission-system

# ------------------------------------------------------------------
# Microsoft Entra ID  (Aditya University Permission Portal)
# Single-tenant app: "Accounts in this organizational directory only"
#
# CLIENT_ID / TENANT_ID  -> App registrations -> your app -> Overview
# CLIENT_SECRET           -> Certificates & secrets -> New client secret
#                           (copy the secret VALUE, not its ID)
#
# REDIRECT_URI must match a registered Web redirect URI EXACTLY,
# including scheme, host, port and path. On Render that is the
# service URL, which is stable across deploys:
#   https://<your-service>.onrender.com/auth/callback
# ------------------------------------------------------------------
CLIENT_ID=your-client-id
TENANT_ID=your-tenant-id
CLIENT_SECRET=your-client-secret

REDIRECT_URI=https://permission-system.onrender.com/auth/callback

# ------------------------------------------------------------------
# Web server
# ------------------------------------------------------------------
# Local only by default. Render injects PORT and sets HOST itself.
HOST=127.0.0.1
PORT=5000

# Development only. Set to false for any real deployment.
FLASK_DEBUG=true

# Development only. Re-reads templates on every request, so a saved template is
# picked up without restarting the server. Without it Jinja keeps the compiled
# template for the life of the process while CSS is read fresh from disk, and
# the two drift apart into a broken-looking layout. Set to false in production.
TEMPLATES_AUTO_RELOAD=true

# Render terminates TLS, so the app is always reached over HTTPS. Set true.
SESSION_COOKIE_SECURE=false

# Sign a session out after this many seconds without activity.
IDLE_TIMEOUT_SECONDS=3600

# REPORT_TIMEZONE is set with the Firestore settings above, where the day
# bucketing it drives is explained.

# ------------------------------------------------------------------
# Outlook SMTP  (university tenant: smtp.office365.com)
# Leave blank to disable email: requests still submit, the app just
# logs that it could not notify.
#
# NOTE: Render's Free compute plan blocks all outbound traffic on ports
# 25, 465 and 587, so SMTP only works on a paid plan. Until then, leave
# these blank and the app will log that notifications were suppressed.
# ------------------------------------------------------------------
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=your-outlook-email@adityauniversity.in
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-outlook-email@adityauniversity.in

# ------------------------------------------------------------------
# Local development sign-in
# Set to false once Entra ID sign-in works. The /auth/dev-login route
# then returns 404 and cannot be used to bypass Microsoft.
# ------------------------------------------------------------------
DEV_MODE=true
DEV_ALLOWED_DOMAIN=adityauniversity.in
